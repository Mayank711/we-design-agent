{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/loads/**",
              "components/navigation/**",
              "ui_kits/loads-app/**",
              "ui_kits/loads-listing/**",
              "ui_kits/rewards-milestone/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Poppins))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Poppins."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|danger|accept|info|premium|neutral)$/]",
        "message": "<Badge> tone must be one of 'success' | 'danger' | 'accept' | 'info' | 'premium' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|activeIcon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, icon, activeIcon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|fullWidth|leadingIcon|trailingIcon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, fullWidth, leadingIcon, trailingIcon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|outlined|yellow|black|hollow|danger|link)$/]",
        "message": "<Button> variant must be one of 'solid' | 'outlined' | 'yellow' | 'black' | 'hollow' | 'danger' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm|inline)$/]",
        "message": "<Button> size must be one of 'md' | 'sm' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|selected|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: children, selected, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|placeholder|type|helper|error|disabled|prefix|inputMode|maxLength|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, onChange, placeholder, type, helper, error, disabled, prefix, inputMode, maxLength, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|text|key|ref|className|style|children)$/]",
        "message": "<LoadDetail> doesn't accept that prop. Declared props: icon, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadAddressStop'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|heading|subHeading|key|ref|className|style|children)$/]",
        "message": "<LoadAddressStop> doesn't accept that prop. Declared props: type, heading, subHeading."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadAddressStop'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:LOADING|UNLOADING)$/]",
        "message": "<LoadAddressStop> type must be one of 'LOADING' | 'UNLOADING'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PremiumPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|style|key|ref|className|style|children)$/]",
        "message": "<PremiumPill> doesn't accept that prop. Declared props: children, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteStop'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|subHeading|type|key|ref|className|style|children)$/]",
        "message": "<RouteStop> doesn't accept that prop. Declared props: heading, subHeading, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='RouteStop'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:LOADING|UNLOADING)$/]",
        "message": "<RouteStop> type must be one of 'LOADING' | 'UNLOADING'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<SegmentTab> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<ToggleSwitch> doesn't accept that prop. Declared props: checked, onChange, disabled, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
